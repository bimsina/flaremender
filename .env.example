# Local development secrets. Copy to `.env.local` and fill in.
#
# Wrangler loads `.env.local` *instead of* `.env` files when it exists, so this
# file has to carry every secret the Worker needs — including the auth ones.

# Better Auth ------------------------------------------------------------
# Optional. Left empty, the origin is read from each request, which is right for
# local development and for a deployed Worker. Set it only if the app sits behind
# a proxy that rewrites the Host header.
BETTER_AUTH_URL=
# Any long random string: `openssl rand -hex 32`.
BETTER_AUTH_SECRET=

# Secret storage ---------------------------------------------------------
# Required. Any passphrase; it is SHA-256'd into an AES-256-GCM key that
# encrypts environment variables and provider API keys at rest. Changing it
# makes every stored secret unreadable, so set it once per instance.
# In production: `wrangler secret put ENCRYPTION_KEY`.
ENCRYPTION_KEY=

# LLM providers ----------------------------------------------------------
# All optional. A key set here wins over anything saved in the admin console,
# and the console refuses to manage a provider that a secret already covers.
# Workers AI needs no key — it runs through the `AI` binding.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

