{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".agents/**",
    "**/routeTree.gen.ts",
    "src/engine/harness/harness.generated.js",
    "worker-configuration.d.ts",
    "migrations/**",
    ".wrangler/**",
    "dist/**"
  ]
}
