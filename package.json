{
  "name": "flaremender",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply flaremender --local",
    "db:migrate:remote": "wrangler d1 migrations apply flaremender --remote",
    "db:push": "drizzle-kit push",
    "db:push:remote": "DRIZZLE_D1_REMOTE=true drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx --yes auth@latest generate --config ./auth.config.ts --output ./src/db/schema/auth.ts --yes",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.12.0",
    "@cloudflare/playwright": "^1.3.6",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.33",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@11.24.0"
}
