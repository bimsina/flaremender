{
  "name": "flaremender",
  "private": true,
  "description": "AI agent that explores your app and writes, runs and repairs Playwright tests. Self-hosted on Cloudflare.",
  "keywords": [
    "ai-agents",
    "browser-rendering",
    "cloudflare-workers",
    "end-to-end-testing",
    "playwright",
    "test-automation"
  ],
  "homepage": "https://github.com/bimsina/flaremender#readme",
  "bugs": {
    "url": "https://github.com/bimsina/flaremender/issues"
  },
  "license": "MIT",
  "author": "Bibek Timsina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bimsina/flaremender.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm run harness && pnpm run trace-viewer && vite dev",
    "harness": "node scripts/build-harness.mjs",
    "trace-viewer": "node scripts/sync-trace-viewer.mjs",
    "generate-routes": "tsr generate",
    "build": "pnpm run harness && pnpm run trace-viewer && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:push": "drizzle-kit push",
    "db:push:remote": "DRIZZLE_D1_REMOTE=true drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx --yes auth@latest generate --config ./auth.config.ts --output ./src/db/schema/auth.ts --yes",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "pnpm run demo:seed && pnpm run screenshots",
    "screenshots": "node --import tsx scripts/capture-screenshots.ts",
    "demo:seed": "node --import tsx --env-file=.env.local scripts/seed-demo.ts",
    "manual:fixtures": "node --import tsx scripts/seed-manual-fixtures.ts",
    "manual:app": "node examples/reliability/serve.mjs",
    "manual:verify": "node --import tsx scripts/verify-manual-fixtures.ts",
    "eval": "node --import tsx --env-file=.env.local evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/google": "^4.0.57",
    "@ai-sdk/openai": "^4.0.51",
    "@better-auth/api-key": "1.7.2",
    "@cloudflare/kumo": "^2.12.0",
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "agents": "0.22.0",
    "ai": "^7.0.84",
    "better-auth": "1.7.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "echarts": "^6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "unpdf": "^1.8.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.33",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "playwright-core": "1.58.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@11.24.0",
  "cloudflare": {
    "label": "Flaremender — AI end-to-end test runner",
    "products": [
      "Workers",
      "D1",
      "R2",
      "Browser Rendering",
      "Workflows",
      "Durable Objects",
      "Workers AI"
    ],
    "categories": [
      "starter"
    ],
    "docs_url": "https://github.com/bimsina/flaremender#readme",
    "publish": false,
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Signing key for session cookies. Generate one with `openssl rand -hex 32`. Changing it signs everyone out."
      },
      "ENCRYPTION_KEY": {
        "description": "Passphrase used to encrypt environment variables and provider API keys at rest (AES-256-GCM). Generate one with `openssl rand -hex 32`. **Set it once** — changing it makes every stored secret permanently unreadable."
      },
      "ANTHROPIC_API_KEY": {
        "description": "Optional. An Anthropic API key for test generation and exploration. You can skip this and add a key from the admin console after signing in."
      },
      "OPENAI_API_KEY": {
        "description": "Optional. An OpenAI API key for test generation and exploration. You can skip this and add a key from the admin console after signing in."
      },
      "GOOGLE_API_KEY": {
        "description": "Optional. A Google AI API key for test generation and exploration. You can skip this and add a key from the admin console after signing in."
      }
    }
  }
}
